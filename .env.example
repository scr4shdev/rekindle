# Copy to .env.local. Every key is optional: with no keys the app runs fully in mock mode.
# Validation lives in src/lib/config.ts (invalid values fail fast; missing keys mean mock mode).

# --- Qloo (Insights API) ---
QLOO_API_KEY=
# Hackathon keys work ONLY on the hackathon host (official hackathon email). Server-side only: never NEXT_PUBLIC_.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Only for developer scripts that use the official `qloo` CLI (qloo exec / qloo mcp); the app ignores it.
# QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# QLOO_TIMEOUT_MS=8000
# QLOO_MAX_RETRIES=2
# QLOO_DEFAULT_TAKE=10
# QLOO_CACHE_TTL_SECONDS=604800

# --- LLM. Unset LLM_PROVIDER: first provider with a key (anthropic > gemini > groq),
#     else mock. Ollama is opt-in: set LLM_PROVIDER=ollama explicitly (no silent
#     auto-upgrade to the local endpoint). ---
# LLM_PROVIDER=gemini   # anthropic | gemini | groq | ollama | mock
#                       # ollama is local-only and typically slower than the
#                       # default deadline: pair it with
#                       #   LLM_TIMEOUT_MS=120000 AGENT_DEADLINE_MS=300000
# REKINDLE_LLM_PROVIDER=ollama   # A/B override; same values as LLM_PROVIDER
# LLM_MODEL=            # override the pinned default model for the provider
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Local Ollama (no key needed; defaults to http://127.0.0.1:11434 and qwen3:8b).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# LLM_TIMEOUT_MS=30000
# LLM_MAX_RETRIES=1
# LLM_CACHE_TTL_SECONDS=604800

# --- Cache. Both set: Upstash Redis; otherwise in-memory. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Runtime ---
# LOG_LEVEL=info
# REKINDLE_FORCE_MOCK=false
# FORMATIVE_AGE_MIN=10
# FORMATIVE_AGE_MAX=30
# MAX_CANDIDATES_PER_DOMAIN=5
# MAX_EXPANSIONS_PER_DOMAIN=4
# MAX_SESSION_STEPS=8
# AGENT_DEADLINE_MS=55000
